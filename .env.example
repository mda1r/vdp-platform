# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vdp_platform?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth Providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Encryption key for sensitive report data (32 bytes hex)
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# File upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"
